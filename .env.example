# Copie ce fichier en .env et renseigne les valeurs. Ne versionne jamais .env.

# Nom de domaine public de l'application (HTTPS automatique). Le DNS doit pointer vers le VPS.
DOMAIN=souvenirs.example.com

# Code demandé pour créer un événement et retrouver la liste des événements (choisis-le long).
ADMIN_CODE=

# Clé de l'API Claude (https://console.anthropic.com). Sans clé, le compte rendu est assemblé
# sans IA (simple mise bout à bout), ce qui ne sert qu'à tester l'installation.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour le récit, le choix des photos et le plan de montage.
CLAUDE_MODEL=claude-opus-5-5

# Modèle Whisper (transcription sur le VPS, CPU) : small (≈2 Go de RAM, rapide),
# medium (≈5 Go, plus fidèle), large-v3 (≈10 Go, lent sans carte graphique).
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr

# Fuseau horaire par défaut (événement de démonstration, purge).
TZ=Europe/Paris

# Jours de conservation des fichiers bruts après la publication.
RAW_RETENTION_DAYS=90

# Taille maximale d'un fichier envoyé, en Mo.
MAX_UPLOAD_MB=2048

# Crée l'événement de démonstration « Week-end entre copains » au premier démarrage.
DEMO_EVENT=true
